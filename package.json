{
  "name": "autowash-manager-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Studio 85 — Sistema Integrado de Gestão para Lava-Rápido e Estética Automotiva",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@autowash/web",
    "dev:api": "npm run dev --workspace=@autowash/api",
    "build": "npm run build -w @autowash/shared && npm run prisma:generate -w @autowash/api && npm run build -w @autowash/api && npm run build:seed -w @autowash/api && npm run build -w @autowash/web",
    "prisma:generate": "npm run prisma:generate --workspace=@autowash/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@autowash/api",
    "prisma:seed": "npm run prisma:seed --workspace=@autowash/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "node server.js"
  },
  "keywords": [
    "autowash",
    "carwash",
    "management",
    "nestjs",
    "react",
    "prisma",
    "mysql"
  ],
  "author": "Forest Development Team",
  "license": "UNLICENSED",
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=20.12"
  },
  "overrides": {
    "multer": "^2.5.0",
    "qs": "^6.17.1",
    "lodash": "^4.18.1",
    "js-yaml@^4": "^4.3.2",
    "picomatch@^4": "^4.0.7",
    "glob@^10": "^10.5.0",
    "tmp": "^0.2.7",
    "ajv@^8": "^8.20.0",
    "webpack": "^5.112.2",
    "js-yaml@^5": "^5.5.0",
    "tailwindcss": {
      "postcss-selector-parser": "^7.1.6"
    },
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    },
    "workbox-build": {
      "glob": "^14.0.2",
      "@trickfilm400/rollup-plugin-off-main-thread": "^4.0.0"
    },
    "@jest/reporters": {
      "glob": "^14.0.2"
    },
    "jest-config": {
      "glob": "^14.0.2"
    },
    "jest-runtime": {
      "glob": "^14.0.2"
    },
    "test-exclude": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
