# Studio 85 — Ponte de WhatsApp
# Copie para .env (não versionar) e preencha. Gere segredos com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3005
# 127.0.0.1 quando a API roda no mesmo servidor; 0.0.0.0 só atrás de HTTPS/firewall
HOST=127.0.0.1

# Mesmo valor de WHATSAPP_BRIDGE_TOKEN na API (apps/api/.env)
API_KEY=

# Para onde a ponte avisa conexão/desconexão do número (rota da API) e o segredo dessa chamada
# (mesmo valor de WHATSAPP_WEBHOOK_SECRET na API)
WEBHOOK_URL=https://SEU-DOMINIO/api/v1/webhooks/whatsapp
WEBHOOK_SECRET=

# Pasta das sessões do WhatsApp (contém as credenciais do número: proteja e faça backup)
AUTH_DIR=./auth_info
