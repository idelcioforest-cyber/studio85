# ==============================================================================
# Studio 85 — Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# ATENÇÃO: NUNCA insira senhas reais ou tokens de produção neste arquivo.
# Copie este arquivo para .env em apps/api e configure os valores do seu ambiente.
# ==============================================================================

# --- Ambiente Geral ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME="Studio 85"
FRONTEND_URL=http://localhost:5173

# --- Banco de Dados MySQL (Prisma) ---
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
# Exemplo local (XAMPP padrão sem senha): mysql://root:@localhost:3306/lavagem
# Exemplo Docker: mysql://autowash_app:app_dev_password_change_me@localhost:3306/lavagem
DATABASE_URL="mysql://root:@localhost:3306/lavagem"

# --- Redis (Filas e Cache) ---
# Formato: redis://:SENHA@HOST:PORTA
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_ENABLED=false

# --- Segurança & Autenticação ---
# Chaves JWT (Gerar com: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Chave mestra para criptografia de dados sensíveis em repouso (CPF AES-256-GCM)
# Chave de 32 bytes em formato hex (64 caracteres hexadecimais)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATA_ENCRYPTION_SALT=autowash_secure_cpf_lookup_salt_dev

# --- CORS ---
# Domínios autorizados separados por vírgula (sem barra no final)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting (Proteção de Força Bruta) ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5

# --- Armazenamento de Arquivos Privados (Fotos Antes/Depois) ---
STORAGE_DRIVER=local
# Em produção (npm start): caminho ABSOLUTO fora da pasta do deploy; vazio = ~/studio85-storage
STORAGE_LOCAL_PATH=./storage/uploads
# Para driver S3 / MinIO / Cloudflare R2:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=autowash-media
S3_ACCESS_KEY=minio_dev_access_key
S3_SECRET_KEY=minio_dev_secret_key

# --- E-mail Transacional (SMTP) ---
# mock = só mostra o código no log/tela (desenvolvimento); smtp = envia de verdade
MAIL_DRIVER=mock
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=nao-responda@seu-dominio.com.br
SMTP_PASSWORD=""
MAIL_FROM_ADDRESS=nao-responda@seu-dominio.com.br
MAIL_FROM_NAME="Studio 85"

# --- Provedores de Pagamento (Fase 5 - Sandbox) ---
# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MERCADOPAGO_WEBHOOK_SECRET=test_mercadopago_webhook_secret

# Stone / Pagar.me
STONE_API_KEY=test_stone_api_key
STONE_SECRET_KEY=test_stone_secret_key
STONE_WEBHOOK_SECRET=test_stone_webhook_secret

# --- WhatsApp Bridge Service (Python VPS) ---
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3005
WHATSAPP_BRIDGE_TOKEN=gere_um_valor_aleatorio_de_64_caracteres_hex
WHATSAPP_ENABLED=false
WHATSAPP_INSTANCE=studio85
WHATSAPP_WEBHOOK_URL=https://SEU-DOMINIO/api/v1/webhooks/whatsapp
WHATSAPP_WEBHOOK_SECRET=gere_outro_valor_aleatorio_de_64_caracteres_hex

# --- SEO ---
# Google Search Console → Verificação por "Tag HTML": cole só o valor de content="..."
GOOGLE_SITE_VERIFICATION=""

# --- Pagamento online (Pagar.me v5, marketplace com split) ---
# Conta compartilhada com outros sistemas: tudo que este cria leva metadata.source = PAGARME_SOURCE_TAG
PAGARME_BASE_URL=https://api.pagar.me/core/v5
PAGARME_SECRET_KEY=""
PAGARME_PUBLIC_KEY=""
# Recebedor da plataforma (comissão)
PAGARME_PLATFORM_RECIPIENT_ID=""
# Comissão da plataforma em %: 2 = 2% para a plataforma e 98% para o lava-jato
PAGARME_PLATFORM_FEE_PERCENT=2
PAGARME_SOURCE_TAG=studio85
# Taxas repassadas ao cliente e parcelas no cartão ficam no painel (Configurações → Pagamento online)
# Temporário (true): sem recebedor do lava-jato liberado, o pagamento online cai inteiro na conta da plataforma
PAGARME_FALLBACK_TO_PLATFORM=false
# Opcional: Basic Auth do webhook /api/webhook/pagarme (vazio = não exige)
PAGARME_WEBHOOK_USER=""
PAGARME_WEBHOOK_PASS=""
